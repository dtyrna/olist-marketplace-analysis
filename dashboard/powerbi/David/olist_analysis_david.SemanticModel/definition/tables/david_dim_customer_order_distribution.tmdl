table david_dim_customer_order_distribution
	lineageTag: 556d6e6d-f6b5-4807-9808-fc1532130a36

	column customer_unique_id
		lineageTag: e617812a-605f-4bb6-9f88-864ef372e8ef
		summarizeBy: none
		isNameInferred
		sourceColumn: dim_customers[customer_unique_id]

		annotation SummarizationSetBy = Automatic

	column 'Order Count'
		formatString: 0
		lineageTag: c5eb3d81-4bea-4c1a-ba83-c4a5957f3b02
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Order Count]

		annotation SummarizationSetBy = Automatic

	column 'Order Count Group' =
			
			SWITCH(
			    TRUE(),
			    [Order Count] = 1, "1 Order",
			    [Order Count] = 2, "2 Orders",
			    [Order Count] = 3, "3 Orders",
			    [Order Count] >= 4, "4+ Orders",
			    BLANK()
			)
		lineageTag: d01ac764-c3b8-4c40-a552-aa471cb613fd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition david_dim_customer_order_distribution = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    VALUES(dim_customers[customer_unique_id]),
				    "Order Count",
				        CALCULATE(
				            DISTINCTCOUNT(dim_orders[order_id])
				        )
				)

	annotation PBI_Id = e61c9cfa14b2454f8d156ebfa38f3f86

