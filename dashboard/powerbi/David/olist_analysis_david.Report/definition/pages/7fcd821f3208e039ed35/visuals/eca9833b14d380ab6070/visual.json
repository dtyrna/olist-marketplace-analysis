  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Findings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt",
                      "color": "#1e3a8a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How valuable are repeat customers, and what does the customer base look like in terms of order frequency and revenue?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Repeat customers are a small but disproportionately valuable segment.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " They represent only ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "3.12% of the customer base",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", but account for ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "6.05% of total order value",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Repeat customers generate substantially higher revenue per customer.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Average revenue is approximately ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "2× higher for repeat customers",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": " than for one-time customers (292.71 vs. 146.33).",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Most customers place only one order.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The customer base is strongly concentrated in the ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "one-order segment",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", indicating limited repeat purchasing.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Customer revenue is strongly right-skewed.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Most customers generate relatively low cumulative order value, while a small group generates substantially higher value.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Methodological Note:",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Repeat customer status is based on observed purchasing behavior in the available dataset and does not establish that retention activities caused higher customer value.",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
