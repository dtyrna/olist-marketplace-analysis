          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Findings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt",
                      "color": "#1e3a8a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Which product categories generate the most negative customer feedback, and how does satisfaction vary across categories?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Negative review rates vary substantially across product categories.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Some categories perform considerably above the marketplace average, indicating category-specific customer satisfaction challenges.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Higher negative review rates are associated with lower average review scores.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The category-level relationship shows a clear negative pattern between negative review rate and average review score.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Review volume differs strongly across categories.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The distribution of review volume indicates that customer feedback is concentrated in a limited number of categories.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Methodological note:",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Category-level relationships indicate associations and do not establish causality. Categories with low review volumes should be interpreted with caution.",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
