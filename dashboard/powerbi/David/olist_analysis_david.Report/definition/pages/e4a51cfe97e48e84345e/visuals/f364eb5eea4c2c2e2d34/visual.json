    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key findings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt",
                      "color": "#1e3a8a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How satisfied are Olist customers and how is customer satisfaction distributed across review ratings and review categories?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Overall customer satisfaction is high",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Customers give an average review score of ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "4.09 out of 5",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", indicating generally positive customer satisfaction.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Positive reviews dominate the review base",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "77.07% of reviews are classified as positive",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", while ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "14.69% are classified as negative",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. 5-star reviews account for the largest share of all ratings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The review distribution is strongly concentrated on ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "5-star ratings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", while low ratings represent a substantially smaller share.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Negative feedback represents a relevant minority",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Despite the high overall satisfaction, almost ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "15% of reviews are classified as negative",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", indicating a meaningful group of dissatisfied customers.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
