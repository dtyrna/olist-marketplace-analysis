            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Findings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt",
                      "color": "#1e3a8a"
                    }
                  }
                ]
              },
              {
