                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How does delivery performance vary by transport type, time and customer region and how strongly is delivery delay associated with customer dissatisfaction?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Interstate orders have substantially longer transit times",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Interstate orders require ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "11.81 days on average",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", compared with ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "4.76 days",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": " for intrastate orders.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Longer transit is associated with higher late-delivery rates",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The late-delivery rate is ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "9.25% for interstate orders",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ", compared with ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": "6.08% for intrastate orders",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Delivery performance varies considerably over time",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The late-delivery rate increases sharply in early 2018, indicating periods of weaker delivery performance.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Methodological Note",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Observed relationships indicate associations and do not establish causality.",
                    "textStyle": {
