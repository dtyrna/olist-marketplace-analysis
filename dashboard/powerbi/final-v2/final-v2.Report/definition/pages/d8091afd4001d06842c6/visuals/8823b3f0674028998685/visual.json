          "properties": {
            "source": {
              "expr": {
                "Literal": {
                  "Value": "'import matplotlib.pyplot as plt\nimport numpy as np\nimport seaborn as sns\n\n# ==========================================\n# 🚨 VISUAL 1: CONFUSION MATRIX ONLY\n# ==========================================\ntn, fp, fn, tp = 1607, 2455, 2311, 12899\ncm = np.array([[tn, fp], [fn, tp]])\n\nfig, ax = plt.subplots(figsize=(6, 5))\n\nsns.heatmap(\n    cm, \n    annot=True, \n    fmt=\"d\", \n    cmap=\"Blues\", \n    xticklabels=[''Schlecht (1-3★)'', ''Gut (4-5★)''], \n    yticklabels=[''Schlecht (1-3★)'', ''Gut (4-5★)''], \n    cbar=False, \n    annot_kws={\"size\": 14, \"weight\": \"bold\"},\n    ax=ax\n)\n\n\nplt.title(\"Model-prediction vs. reality\\n(Confusion matrix)\", fontsize=12, weight=\"bold\", pad=15)\nplt.ylabel(''True score (Gold Layer)'', fontsize=11, weight=\"bold\", labelpad=10)\nplt.xlabel(''Predicted score (Model)'', fontsize=11, weight=\"bold\", labelpad=10)\n\nplt.tight_layout()\nplt.show()\n'"
                }
              }
            },
