            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Findings",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt",
                      "color": "#1e3a8a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How does seller performance vary in terms of customer satisfaction and delivery performance?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Seller performance varies substantially.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Negative review rates differ considerably across sellers, indicating heterogeneous customer experiences.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Delivery performance shows an association with negative reviews.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Sellers with higher late-delivery rates tend to show higher negative review rates, although substantial variation remains.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Seller-level delivery variance alone does not fully explain customer satisfaction.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The relationship between delivery variance and negative review rate is relatively weak and widely dispersed.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Methodological note:",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Seller-level relationships indicate associations and do not establish causality. Orders may contain multiple sellers, which limits seller-level attribution.",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
