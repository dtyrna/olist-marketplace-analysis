	partition ML_Data_Warehouse_Flat = calculated
		mode: import
		source = ```
				
				SELECTCOLUMNS(
				    NATURALINNERJOIN(
				        fact_order_reviews,
				        dim_orders
				    ),
				    "order_id", dim_orders[order_id],
				    "review_score", [review_score],
				    "distance_category", dim_orders[distance_categorys],
				    
				   
				    "purchase_key", RELATED('dim_purchase_date'[date_key]),
				    "delivered_key", RELATED('dim_delivered_date'[date_key]),
				    "estimated_key", RELATED('dim_estimated_delivery_date'[date_key])
				)
				
				```

	annotation PBI_Id = 299c86e62cf241e0bbae3e34f58d0981

