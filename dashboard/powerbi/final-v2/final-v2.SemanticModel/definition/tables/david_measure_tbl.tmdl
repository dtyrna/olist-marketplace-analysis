	measure 'Total Orders' =
			
			DISTINCTCOUNT(
			    dim_orders[order_id]
			)
		formatString: 0
		lineageTag: e31ed461-e0fc-406d-b585-86098bcfe4b0

	measure 'Customer Count by Revenue Bucket' =
			
			VAR MinRevenue =
			    MIN('david_dim_customer_revenue_bucket'[Min Revenue])
			
			VAR MaxRevenue =
			    MAX('david_dim_customer_revenue_bucket'[Max Revenue])
			
			RETURN
			COUNTROWS(
			    FILTER(
			        VALUES(dim_customers[customer_unique_id]),
			        VAR CustomerRevenue =
			            CALCULATE(
			                [Customer Revenue]
			            )
			        RETURN
			            CustomerRevenue >= MinRevenue
			                && CustomerRevenue < MaxRevenue
			    )
			)
		formatString: 0
		lineageTag: c77c2008-f445-499c-ae11-ce70836eaa2b

	measure 'Median Revenue per Customer' =
			
			MEDIANX(
			    VALUES(dim_customers[customer_unique_id]),
			    CALCULATE(
			        [Customer Revenue]
			    )
			)
		lineageTag: 7eccd92f-5d61-4c0d-bdc7-b554f0e88777

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Revenue per One-time Customer' =
			
			MEDIANX(
			    FILTER(
			        VALUES(dim_customers[customer_unique_id]),
			        CALCULATE(
			            DISTINCTCOUNT(dim_orders[order_id])
			        ) = 1
			    ),
			    CALCULATE(
			        [Customer Revenue]
			    )
			)
		lineageTag: 5b9ee351-3bbc-46cf-8a6a-fe6c33cbcb69

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Revenue per Repeat Customer' =
			
			MEDIANX(
			    FILTER(
			        VALUES(dim_customers[customer_unique_id]),
			        CALCULATE(
			            DISTINCTCOUNT(dim_orders[order_id])
			        ) > 1
			    ),
			    CALCULATE(
			        [Customer Revenue]
			    )
			)
		lineageTag: cf0100ee-17f3-4b3e-bc10-759886c481cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'One-time Customers' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dim_customers[customer_unique_id]),
			        CALCULATE(
			            DISTINCTCOUNT(dim_orders[order_id])
			        ) = 1
			    )
			)
		formatString: 0
		lineageTag: 1c6d4daa-c085-4c48-92aa-b5bf2e53faac

	measure 'Repeat Customer Rate' =
			
			DIVIDE(
			    [Repeat Customers],
			    [Total Customers]
			)
		lineageTag: 02a3d34d-fc45-4aff-b52c-a6d025a1aad9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Repeat Customers' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dim_customers[customer_unique_id]),
			        CALCULATE(
			            DISTINCTCOUNT(dim_orders[order_id])
			        ) > 1
			    )
			)
		formatString: 0
		lineageTag: 4c160d30-ae61-4366-8f27-6d3e4badbc55

	measure 'Total Customers' =
			
			DISTINCTCOUNT(
			    dim_customers[customer_unique_id]
			)
		formatString: 0
		lineageTag: 66435c1f-a64f-448e-8d5f-25cb04060dd9

	measure 'Average Carrier Transit Days - Transport Type' =
			
			SWITCH(
			    SELECTEDVALUE(david_dim_transport_type[Transport Type]),
			    "Interstate", [Average Carrier Transit Days - Interstate],
			    "Intrastate", [Average Carrier Transit Days - Intrastate]
			)
		lineageTag: acb2db69-b50d-4680-b5a0-5365c4605c21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Delivery Rate - Transport Type' =
			
