			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            HasDifferentState
			                && dim_orders[order_delivered_customer_date]
			                    > dim_orders[order_estimated_delivery_date]
			    )
			)
		formatString: 0
		lineageTag: 97cb8768-1473-4383-8e69-182653314945

	measure 'Late Orders - Intrastate' =
			
			VAR OrdersWithDeliveryData =
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			            && NOT ISBLANK(dim_orders[order_estimated_delivery_date])
			    )
			
			RETURN
			COUNTROWS(
			    FILTER(
			        OrdersWithDeliveryData,
			
			        VAR CurrentOrder = dim_orders[order_id]
			
			        VAR CustomerState =
			            RELATED(dim_customers[customer_state])
			
			        VAR SellerIDs =
			            CALCULATETABLE(
			                VALUES(fact_order_items[seller_id]),
			                fact_order_items[order_id] = CurrentOrder
			            )
			
			        VAR SellerStates =
			            CALCULATETABLE(
			                VALUES(dim_sellers[seller_state]),
			                TREATAS(
			                    SellerIDs,
			                    dim_sellers[seller_id]
			                )
			            )
			
			        VAR HasDifferentState =
			            COUNTROWS(
			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            NOT HasDifferentState
			                && dim_orders[order_delivered_customer_date]
			                    > dim_orders[order_estimated_delivery_date]
			    )
			)
		formatString: 0
		lineageTag: 50c14eab-4f24-43e2-ab63-43de922aa282

	measure 'Orders - Interstate Correct' =
			
			VAR OrdersWithTransit =
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    )
			
			RETURN
			COUNTROWS(
			    FILTER(
			        OrdersWithTransit,
			
			        VAR CurrentOrder = dim_orders[order_id]
			        VAR CustomerState =
			            RELATED(dim_customers[customer_state])
			
			        VAR SellerIDs =
			            CALCULATETABLE(
			                VALUES(fact_order_items[seller_id]),
			                fact_order_items[order_id] = CurrentOrder
			            )
			
			        VAR SellerStates =
			            CALCULATETABLE(
			                VALUES(dim_sellers[seller_state]),
			                TREATAS(
			                    SellerIDs,
			                    dim_sellers[seller_id]
			                )
			            )
			
			        VAR HasDifferentState =
			            COUNTROWS(
			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            HasDifferentState
			    )
			)
		formatString: 0
		lineageTag: 116a390a-5e6e-4ee5-9e1e-f050d9d4e2ab

	measure 'Orders - Intrastate' =
			
			VAR OrdersWithTransit =
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    )
			
			RETURN
			COUNTROWS(
			    FILTER(
			        OrdersWithTransit,
			
			        VAR CurrentOrder = dim_orders[order_id]
			        VAR CustomerState =
			            RELATED(dim_customers[customer_state])
			
			        VAR SellerIDs =
			            CALCULATETABLE(
			                VALUES(fact_order_items[seller_id]),
			                fact_order_items[order_id] = CurrentOrder
			            )
			
			        VAR SellerStates =
			            CALCULATETABLE(
			                VALUES(dim_sellers[seller_state]),
			                TREATAS(
			                    SellerIDs,
			                    dim_sellers[seller_id]
			                )
			            )
			
			        VAR HasDifferentState =
			            COUNTROWS(
			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            NOT HasDifferentState
			    )
			)
		formatString: 0
		lineageTag: 812443b4-8e29-4b0e-80f1-eb8fc8ea2523

	measure 'Orders with Carrier Transit Time' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_orders[order_id]),
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    )
			)
		formatString: 0
		lineageTag: e386b44f-2ff8-4681-ae95-e5fd88359a91

	measure 'Orders with Carrier Transit Time by Route' =
			
			CALCULATE(
			    [Orders with Carrier Transit Time],
			    CROSSFILTER(
			        dim_orders[order_id],
			        fact_order_items[order_id],
			        BOTH
			    )
			)
		formatString: 0
		lineageTag: 37113902-8daf-4515-b286-c686653bc079

	measure 'Orders with Carrier Transit Time by Seller' =
			
			CALCULATE(
			    [Orders with Carrier Transit Time],
			    CROSSFILTER(
			        dim_orders[order_id],
			        fact_order_items[order_id],
			        BOTH
			    )
			)
