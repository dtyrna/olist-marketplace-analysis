	measure 'Late Review Rate' =
			
			DIVIDE(
			    [Late Reviews],
			    [Total Reviews]
			)
		lineageTag: ffc27a04-8afb-4e34-aa0e-e1b9bbd12a40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Review Rate by Seller' =
			
			VAR SellerOrders =
			    VALUES(fact_order_items[order_id])
			
			VAR ReviewedOrders =
			    VALUES(fact_order_reviews[order_id])
			
			VAR SellerReviewedOrders =
			    INTERSECT(
			        SellerOrders,
			        ReviewedOrders
			    )
			
			VAR ReviewedOrderCount =
			    COUNTROWS(SellerReviewedOrders)
			
			VAR LateOrderCount =
			    SUMX(
			        SellerReviewedOrders,
			        VAR CurrentOrderID = [order_id]
			        VAR DeliveryVariance =
			            CALCULATE(
			                MAX(dim_orders[david_Delivery Variance Days]),
			                TREATAS(
			                    { CurrentOrderID },
			                    dim_orders[order_id]
			                )
			            )
			        RETURN
			            IF(
			                NOT ISBLANK(DeliveryVariance)
			                    && DeliveryVariance > 0,
			                1,
			                0
			            )
			    )
			
			RETURN
			    DIVIDE(
			        LateOrderCount,
			        ReviewedOrderCount
			    )
		lineageTag: fb78fc69-0c33-4c32-b5a4-85fefeeae7d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Reviews' =
			
			CALCULATE(
			    [Total Reviews],
			    dim_orders[david_Delivery Variance Days] > 0
			)
		formatString: 0
		lineageTag: efda5cb5-5715-40cd-bcf9-18766a7f1811

