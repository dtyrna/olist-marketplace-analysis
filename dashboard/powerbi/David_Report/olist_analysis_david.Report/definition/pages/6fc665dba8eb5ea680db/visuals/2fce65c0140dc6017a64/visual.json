            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Findings ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt",
                      "color": "#1e3a8a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How does delivery performance affect customer satisfaction and negative reviews?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Delivery delays are strongly associated with lower customer satisfaction.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Average review scores remain above 4.0 for orders delivered on or before the estimated date, but decline substantially for orders delivered more than one week late.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Negative reviews increase sharply with delivery delays.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The negative review rate rises strongly once orders are delivered more than 7 days after the estimated delivery date.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Most reviewed orders are delivered ahead of the estimated date.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " The largest review volumes are concentrated in orders delivered at least one week before the estimated delivery date.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Methodological Note",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The analysis shows an association between delivery variance and customer satisfaction; it does not establish causality.",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
