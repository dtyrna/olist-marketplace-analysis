table dim_orders
	lineageTag: 67956d8f-a92f-4248-a53a-df67516b572d

	measure 'Delivered Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_orders[order_id]),
			    dim_orders[order_status] = "delivered"
			)
		formatString: 0
		lineageTag: ce5a9fde-7bf3-4eee-b02d-909b3965d7e6

	measure 'Average Carrier Transit Days' =
			
			AVERAGEX(
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    ),
			    DATEDIFF(
			        dim_orders[order_delivered_carrier_date],
			        dim_orders[order_delivered_customer_date],
			        DAY
			    )
			)
		lineageTag: 7a70039b-cbe5-4ca8-a8e3-2714b5dc560d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders with Carrier Transit Time' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_orders[order_id]),
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    )
			)
		formatString: 0
		lineageTag: e386b44f-2ff8-4681-ae95-e5fd88359a91

	measure 'Average Carrier Transit Days by Seller' =
			
			CALCULATE(
			    [Average Carrier Transit Days],
			    CROSSFILTER(
			        dim_orders[order_id],
			        fact_order_items[order_id],
			        BOTH
			    )
			)
		lineageTag: af460a97-6c38-4e63-a9a5-d403c97c2e4b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders with Carrier Transit Time by Seller' =
			
			CALCULATE(
			    [Orders with Carrier Transit Time],
			    CROSSFILTER(
			        dim_orders[order_id],
			        fact_order_items[order_id],
			        BOTH
			    )
			)
		formatString: 0
		lineageTag: eb6e787c-6e70-4797-b7bc-f63b40c85670

	measure 'Average Carrier Transit Days by Route' =
			
			CALCULATE(
			    [Average Carrier Transit Days],
			    CROSSFILTER(
