			        VAR CurrentOrder = dim_orders[order_id]
			        VAR CustomerState =
			            RELATED(dim_customers[customer_state])
			
			        VAR SellerIDs =
			            CALCULATETABLE(
			                VALUES(fact_order_items[seller_id]),
			                fact_order_items[order_id] = CurrentOrder
			            )
			
			        VAR SellerStates =
			            CALCULATETABLE(
			                VALUES(dim_sellers[seller_state]),
			                TREATAS(
			                    SellerIDs,
			                    dim_sellers[seller_id]
			                )
			            )
			
			        VAR HasDifferentState =
			            COUNTROWS(
			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            HasDifferentState
			    ),
			    
			    DATEDIFF(
			        dim_orders[order_delivered_carrier_date],
			        dim_orders[order_delivered_customer_date],
			        DAY
			    )
			)
			```
		lineageTag: e7aaa7e8-5479-4413-8be5-ee5bf2d661be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Carrier Transit Days - Intrastate' =
			
			VAR OrdersWithTransit =
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    )
			
			RETURN
			AVERAGEX(
			    FILTER(
			        OrdersWithTransit,
			
			        VAR CurrentOrder = dim_orders[order_id]
			        VAR CustomerState =
			            RELATED(dim_customers[customer_state])
			
			        VAR SellerIDs =
			            CALCULATETABLE(
			                VALUES(fact_order_items[seller_id]),
			                fact_order_items[order_id] = CurrentOrder
			            )
			
			        VAR SellerStates =
			            CALCULATETABLE(
			                VALUES(dim_sellers[seller_state]),
			                TREATAS(
			                    SellerIDs,
			                    dim_sellers[seller_id]
			                )
			            )
			
			        VAR HasDifferentState =
			            COUNTROWS(
			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            NOT HasDifferentState
			    ),
			
			    DATEDIFF(
			        dim_orders[order_delivered_carrier_date],
			        dim_orders[order_delivered_customer_date],
			        DAY
			    )
			)
		lineageTag: 38f1799c-170e-4a94-8170-3a4ab834b22f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders - Intrastate' =
			
			VAR OrdersWithTransit =
			    FILTER(
			        dim_orders,
			        dim_orders[order_status] = "delivered"
			            && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			            && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			    )
			
			RETURN
			COUNTROWS(
			    FILTER(
			        OrdersWithTransit,
			
			        VAR CurrentOrder = dim_orders[order_id]
			        VAR CustomerState =
			            RELATED(dim_customers[customer_state])
			
			        VAR SellerIDs =
			            CALCULATETABLE(
			                VALUES(fact_order_items[seller_id]),
			                fact_order_items[order_id] = CurrentOrder
			            )
			
			        VAR SellerStates =
			            CALCULATETABLE(
			                VALUES(dim_sellers[seller_state]),
			                TREATAS(
			                    SellerIDs,
			                    dim_sellers[seller_id]
			                )
			            )
			
			        VAR HasDifferentState =
			            COUNTROWS(
			                FILTER(
			                    SellerStates,
			                    dim_sellers[seller_state] <> CustomerState
			                )
			            ) > 0
			
			        RETURN
			            NOT HasDifferentState
			    )
			)
		formatString: 0
		lineageTag: 812443b4-8e29-4b0e-80f1-eb8fc8ea2523

	measure 'Average Carrier Transit Days - Interstate Route' =
			
			VAR SellerState =
			    SELECTEDVALUE(dim_sellers[seller_state])
			
			VAR CustomerState =
			    SELECTEDVALUE(dim_customers[customer_state])
			
			RETURN
			    IF(
			        SellerState <> CustomerState,
			        [Average Carrier Transit Days by Route],
			        BLANK()
			    )
		lineageTag: 863a9e1e-f2c6-4d12-b897-0bdd8ff8fd33

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Carrier Transit Days - Interstate Route 100+' =
			
			VAR OrderCount =
			    [Orders with Carrier Transit Time by Route]
			
			RETURN
			    IF(
			        OrderCount >= 100,
			        [Average Carrier Transit Days by Route],
			        BLANK()
			    )
		lineageTag: 85b5b7be-4066-4157-b07d-371a2ece1277

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Interstate Order Share' =
			
			DIVIDE(
			    [Orders - Interstate Correct],
			    [Orders with Carrier Transit Time],
			    0
			)
		lineageTag: 1da9ddf6-0cb6-4d78-b7d3-6e79727d98c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

