	measure Total_Orders_Count = ```
			COUNT('fact_order_items'[order_id])
			
			
			```
		formatString: 0
		lineageTag: c787b3a6-7bc5-4dc3-9bcb-611f08fce1d6

	measure timetillcarrier = ```
			
			AVERAGEX(
			    'fact_order_items',
			    VAR StartDate = RELATED('dim_orders'[order_purchase_timestamp])
			    VAR EndDate = RELATED('dim_orders'[order_delivered_carrier_date])
			    
			    -- Gesamte Tage berechnen
			    VAR TotalDays = DATEDIFF(StartDate, EndDate, DAY)
			    
			    -- Ermitteln, wie viele Wochenenden (Sonntage) rein rechnerisch dazwischenliegen
			    VAR FullWeeks = INT(TotalDays / 7)
			    VAR RemainingDays = MOD(TotalDays, 7)
			    VAR StartDayOfWeek = WEEKDAY(StartDate, 2) -- 1 = Mo, 7 = So
			    
			    -- Prüfen, ob der verbleibende Rest über einen Sonntag rutscht
			    VAR SundayCrossed = IF(StartDayOfWeek + RemainingDays >= 7, 1, 0)
			    VAR TotalSundays = FullWeeks + SundayCrossed
			    
			    RETURN
			    IF(
			        ISBLANK(EndDate) || ISBLANK(StartDate), 
			        BLANK(),
			        -- Gesamte Tage minus die arbeitsfreien Sonntage
			        TotalDays - TotalSundays
			    )
			)
			
			```
		lineageTag: 3b0e6632-ea31-48d7-869c-12b99a21ceb5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure timespan_delivery = ```
			
			AVERAGEX(
			    'fact_order_items',
			    DATEDIFF(
			        RELATED('dim_orders'[order_delivered_carrier_date]), 
			        RELATED('dim_orders'[order_delivered_customer_date]), 
			        DAY
			    )
			)
			
			```
		lineageTag: dceab471-2efe-4e70-acd7-64c5fb659d7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure review_distance = ```
			
			CALCULATE(
			    COUNT('fact_order_reviews'[review_score]),
			    CROSSFILTER('fact_order_reviews'[order_id], 'dim_orders'[order_id], Both)
			)
			
			```
		formatString: 0
		lineageTag: f65a695a-cd3a-48be-83f9-166185cd6786

	measure Prozent_pro_Distanzzeile = ```
			
			VAR AktuelleDistanz = SELECTEDVALUE('dim_orders'[distance_categorys])
			VAR AktuellerZellenWert = COUNT('fact_order_items'[order_id])
			
			VAR SummeDerGanzenZeile = 
			    CALCULATE(
			        COUNT('fact_order_items'[order_id]), 
			        ALL('fact_order_items'),
			        'dim_orders'[distance_categorys] = AktuelleDistanz
			    )
			RETURN
			DIVIDE(AktuellerZellenWert, SummeDerGanzenZeile, 0)
			
			
			```
		lineageTag: d4e1cd09-730a-4175-80c6-65e5a2b50a11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

