	column purchase_before_approved_flag = ```
			
			IF(
			    NOT ISBLANK(dim_orders[order_purchase_timestamp]) && NOT ISBLANK(dim_orders[order_approved_at]), 
			    IF(
			        dim_orders[order_purchase_timestamp] <= dim_orders[order_approved_at], 
			        TRUE(),
			        FALSE()
			    ),
			    TRUE()
			)
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 8bd9d4f3-73f2-47f1-9ab0-128e722c299a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column hours_purchase_to_delivered_carrier =
			
			IF(
			    NOT ISBLANK(dim_orders[order_purchase_timestamp])
			        && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			        && dim_orders[order_delivered_carrier_date]
			            >= dim_orders[order_purchase_timestamp],
			    DATEDIFF(
			        dim_orders[order_purchase_timestamp],
			        dim_orders[order_delivered_carrier_date],
			        HOUR
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: fc9287cd-2b25-40a1-83f0-5dd310640239
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column days_purchase_to_delivered_carrier =
			
			IF(
			    NOT ISBLANK(dim_orders[order_purchase_timestamp])
			        && NOT ISBLANK(dim_orders[order_delivered_carrier_date])
			        && dim_orders[order_delivered_carrier_date]
			            >= dim_orders[order_purchase_timestamp],
			    DATEDIFF(
			        dim_orders[order_purchase_timestamp],
			        dim_orders[order_delivered_carrier_date],
			        DAY
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: 42d3852b-8095-472c-9a9c-524b8fcf0a8b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column is_single_pos =
			
			VAR MaxItemForOrder =
			    CALCULATE(
			        MAX(fact_order_items[order_item_id]),
			        ALLEXCEPT(dim_orders, dim_orders[order_id])
			    )
			RETURN
			    IF(MaxItemForOrder = 1, 1, 0)
		formatString: 0
		lineageTag: 9ac89bd8-1303-44b8-bbca-7fbf64776b6b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column days_delayed_delivery =
			
			IF(
			    NOT ISBLANK(dim_orders[order_estimated_delivery_date])
			        && NOT ISBLANK(dim_orders[order_delivered_customer_date])
			        ,
			    DATEDIFF(
			        dim_orders[order_estimated_delivery_date],
			        dim_orders[order_delivered_customer_date],
			        DAY
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: 22a76b82-45b3-42a9-9186-023c52fd7d6c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column seller_order_type =
			
			VAR SellerCount =
			    CALCULATE(
			        DISTINCTCOUNT(fact_order_items[seller_id])
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        SellerCount = 1, "Single Seller",
			        SellerCount > 1, "Multi Seller",
			        "Unknown"
			    )
		lineageTag: dddfccb7-abbc-4690-bd5e-912b82fbf0ce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

